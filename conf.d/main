#!/bin/bash -ex

. /usr/local/src/tkl-bashlib/init.sh

ADMIN_USER=gitea
ADMIN_PASS=turnkey
ADMIN_EMAIL=admin@example.org
DB_NAME=gitea
DB_USER=gitea
DB_PASS=turnkey1

SRC=/usr/local/src

useradd -M git
service mysql start

MYSQL_BATCH="mysql --batch"

# create database and user
mysqladmin create "${DB_NAME}"
$MYSQL_BATCH --execute "grant all privileges on ${DB_NAME}.* to '${DB_USER}'@localhost identified by '${DB_PASS}'; alter database ${DB_NAME} character set = utf8 collate = utf8_general_ci;"

rm -f /etc/nginx/sites-enabled/default
ln -s /etc/nginx/sites-available/gitea /etc/nginx/sites-enabled/gitea

export USER=git HOME=/home/git GITEA_WORK_DIR=/home/git
mv $SRC/gitea-*-linux-amd64 $HOME/gitea
chmod +x /home/git/gitea
mkdir $HOME/run
mkdir -p $HOME/custom/conf
mv $SRC/app.example.ini $HOME/custom/conf/
chown -R git:git /home/git

service nginx start
service mysql start

runuser - git -c 'GITEA__security__INSTALL_LOCK=true ./gitea web --pid $HOME/tmp.pid' 2>&1 >/root/gitea-start.log &

echo "Waiting for Gitea to install and start"
wait_until_ok \
    "test -S /home/git/run/gitea.sock" \
    2 60

rm /root/gitea-start.log

runuser - git -c "./gitea admin user create --admin --username $ADMIN_USER --password $ADMIN_PASS --email $ADMIN_EMAIL"

kill "$(cat $HOME/tmp.pid)"
rm "$HOME/tmp.pid"

service nginx stop
service mysql stop

systemctl enable gitea
systemctl enable nginx

# Keep the service binary, templates and configuration outside the Gitea
# process write boundary. Repositories, runtime data, logs and SSH keys remain
# writable by the service account.
chown -R root:root /home/git
for runtime_dir in data log run .ssh; do
    install -d -o git -g git -m 0750 "/home/git/$runtime_dir"
    chown -R git:git "/home/git/$runtime_dir"
done
chmod 0755 /home/git/gitea
chown -R root:git /etc/gitea
find /etc/gitea -type d -exec chmod 0750 {} +
find /etc/gitea -type f -exec chmod 0640 {} +
